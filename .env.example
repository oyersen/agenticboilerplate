# ==========================================
# Database Configuration
# ==========================================
# In production, use high-entropy passwords (e.g. openssl rand -base64 24)
POSTGRES_USER=app_db_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PROD_MIN_16_CHARS
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=enterprise_app_db

# ==========================================
# Keycloak IAM Configuration
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_KEYCLOAK_PASSWORD
KEYCLOAK_AUTH_SERVER_URL=http://localhost:80/auth
KEYCLOAK_REALM=app-realm
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET_MIN_32_CHARS

# ==========================================
# Backend API Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://localhost:80/auth
VITE_KEYCLOAK_REALM=app-realm
VITE_KEYCLOAK_CLIENT_ID=frontend-client
