# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=app_db

# ==========================================
# Keycloak Configuration
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_AUTH_SERVER_URL=http://localhost:80/auth
KEYCLOAK_REALM=app-realm
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=backend-secret

# ==========================================
# Backend API Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_URL=/api
VITE_KEYCLOAK_URL=http://localhost:80/auth
VITE_KEYCLOAK_REALM=app-realm
VITE_KEYCLOAK_CLIENT_ID=frontend-client
